<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- microphone input (asked for at runtime) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- ableton link, osc, patch sharing -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- lets ableton link receive multicast, which many devices filter out unless a MulticastLock is held -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- BespokeAudioService, which keeps the audio running at full speed while bespoke isn't in front -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- hardwareAccelerated is off for the app, on for the activity: JUCE draws with OpenGL itself, and android's
         2D acceleration slows that down (same as what Projucer generates) -->
    <application
        android:name="com.rmsl.juce.JuceApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- a plain Activity is what Projucer uses: JUCE drives it through JuceApp's lifecycle callbacks. (JUCE's
             JuceActivity only works with JUCE_PUSH_NOTIFICATIONS_ACTIVITY defined, which registers its natives)
             configChanges: handle rotation, keyboard etc ourselves instead of android recreating the activity,
             which would tear down the audio device and gl context -->
        <activity
            android:name="android.app.Activity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|navigation|uiMode|density"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:hardwareAccelerated="true"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- offer to open bespoke when a Move or Push 2 is plugged in. if the user agrees, that also gives bespoke
                 access to the device for its display, so it doesn't have to ask separately -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- stopWithTask: swiping bespoke away in recents stops the service, so it doesn't keep the audio running -->
        <service
            android:name="com.ryanchallinor.bespokesynth.BespokeAudioService"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true"
            android:exported="false" />
    </application>
</manifest>
